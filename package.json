{
  "name": "chainproof-hardhat",
  "version": "1.0.0",
  "description": "ChainProof - Decentralized Placement Tracking System. Hardhat root project for smart contract compilation, testing, and deployment.",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
