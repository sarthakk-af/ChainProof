# ChainProof Frontend — Environment Configuration
# Copy this to .env for local development.

# URL of the backend service (see backend/.env.example)
VITE_BACKEND_URL=http://localhost:4000

# Optional: pin each drive's job description to real IPFS via Pinata's free
# tier (see src/utils/ipfsService.js). Get a key at https://app.pinata.cloud ->
# API Keys -> New Key (needs the "pinJSONToIPFS" permission). Leave unset and a
# well-formed placeholder hash is used instead — the app works fully either way;
# this only makes the hash a real, independently fetchable IPFS document.
VITE_PINATA_JWT=
