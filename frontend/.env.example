# ChainProof Frontend — Environment Configuration
# Copy this to .env for local development.

# URL of the backend service (see backend/.env.example)
VITE_BACKEND_URL=http://localhost:4000

# Optional: pin credential/visit metadata to real IPFS via Pinata's free tier
# (see src/utils/ipfsService.js) instead of the local-browser-only mock.
# Get one free at https://app.pinata.cloud -> API Keys -> New Key (needs the
# "pinJSONToIPFS" permission). Leave unset to keep using the mock — the app
# works fully either way, this just makes the ipfsHash a real, independently
# verifiable IPFS CID instead of a local-only placeholder.
VITE_PINATA_JWT=
