# ChainProof Backend — Environment Configuration
# ================================================
# Copy this to .env and fill in your actual values. Never commit .env.

# ---------------------------------------------------------------------------
# Chain connection
# ---------------------------------------------------------------------------
# Local Hardhat node by default. Point this at a testnet/mainnet RPC in later phases.
RPC_URL=http://127.0.0.1:8545

# Private key of the ActorRegistry's `verifier` address (the account that deployed
# the contracts locally holds this role by default — see scripts/deploy.js).
# Local Hardhat accounts are well-known/public and hold no real funds — safe to
# use directly for local development. NEVER put a real-funds key here.
VERIFIER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Admin API
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# User accounts & custodial wallets
# ---------------------------------------------------------------------------
# Signs user session tokens. Any long random string.
JWT_SECRET=

# Encrypts each user's custodial wallet private key at rest (AES-256-GCM).
# Must be a 32-byte key, hex-encoded (64 hex characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# Private key of the wallet that funds new users' custodial wallets with a
# little gas so they can transact. Defaults to VERIFIER_PRIVATE_KEY if unset —
# fine for local dev (Hardhat test accounts hold ~10000 free test ETH each).
TREASURY_PRIVATE_KEY=

# How much native token to send each new custodial wallet at signup.
WALLET_GAS_DRIP_ETH=1.0

# ---------------------------------------------------------------------------
# Email (Brevo — https://www.brevo.com, free tier)
# ---------------------------------------------------------------------------
# Get an API key from Brevo's dashboard (SMTP & API > API Keys). Required in
# practice, not just optional: signup emails a one-time code that must be
# verified before the account can log in at all (see routes/auth.js's
# /verify-email) — with this unset, nobody can ever finish signing up.
# Password-reset emails go through the same channel.
BREVO_API_KEY=
# Must be an address you've verified as a sender in Brevo.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ChainProof

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Where the frontend runs — used both to build password-reset links and to
# restrict CORS to just this origin.
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Path to the SQLite database file (created automatically if missing).
DB_PATH=./data/chainproof.sqlite

# The platform owner's login, created automatically the first time the backend
# starts. This replaces the old shared ADMIN_API_KEY, which was a bearer token
# anyone holding could act with and which attributed nothing to a person.
# Leave ADMIN_PASSWORD empty and the backend will tell you to set it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
