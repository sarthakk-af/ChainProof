# ChainProof Environment Configuration
# ======================================
# Copy this to .env and fill in your values. .env itself is gitignored and must
# never be committed; this example file holds no secrets.

# ---------------------------------------------------------------------------
# Deployment Keys (Required for testnet deployments)
# ---------------------------------------------------------------------------
# Your Ethereum wallet private key (without the 0x prefix is fine)
# WARNING: Never use a wallet with real mainnet funds for testing.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# RPC Endpoints (Required for testnet deployments)
# ---------------------------------------------------------------------------
# Get a free RPC URL from Alchemy (https://www.alchemy.com) or Infura.
# Polygon Amoy is the only network this project deploys to.
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# ---------------------------------------------------------------------------
# Block Explorer Verification (Optional)
# ---------------------------------------------------------------------------
# For verifying the deployed contracts on Amoy — https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Gas Reporting (Optional)
# ---------------------------------------------------------------------------
# Set to "true" to enable gas cost reporting in test runs
REPORT_GAS=false
# Get from https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# ---------------------------------------------------------------------------
# Local development (optional)
# ---------------------------------------------------------------------------
# Points `npm run deploy:local` at a node on another port, so a throwaway chain
# can be deployed to without disturbing the one on 8545.
LOCAL_RPC_URL=http://127.0.0.1:8545

# ---------------------------------------------------------------------------
# Backend & Frontend config
# ---------------------------------------------------------------------------
# The backend and frontend each have their own .env now (backend/.env.example,
# frontend/.env.example) — this file only covers the Hardhat/contracts side
# (compiling, testing, and deploying the contracts themselves).
