# ChainProof — configuration
# ==========================
# The one settings file for the contracts and the backend. Copy this to `.env`
# in the same folder (the project root) and fill it in. `.env` is gitignored
# and must never be committed; this example holds no secrets.
#
# The frontend has its own small file (frontend/.env) on purpose: everything it
# reads is compiled into the website and sent to every visitor, so it must
# never share a file with private keys.

# ---------------------------------------------------------------------------
# Which blockchain
# ---------------------------------------------------------------------------
# localhost — a Hardhat node on this machine (`npx hardhat node`). Needs no
#             keys: the backend uses Hardhat's built-in account #0, the same
#             account `npm run deploy:local` deploys with.
# amoy      — Polygon's public test network. Needs AMOY_RPC_URL and
#             DEPLOYER_PRIVATE_KEY below, plus `npm run deploy:amoy`.
NETWORK=localhost

# Optional: a local node on another port.
# LOCAL_RPC_URL=http://127.0.0.1:8545

# A Polygon Amoy RPC endpoint, e.g. from https://www.alchemy.com (free tier).
AMOY_RPC_URL=

# The key that deploys the contracts on Amoy. Deploying makes this address the
# platform verifier, so the backend signs admin actions with it as well, and
# (unless TREASURY_PRIVATE_KEY is set) pays users' gas from it. Fund it with
# test POL from a faucet. Never use a key that holds real money.
DEPLOYER_PRIVATE_KEY=

# Optional: a separate wallet to pay users' gas, if you'd rather not spend the
# verifier's balance on it.
# TREASURY_PRIVATE_KEY=

# Optional: gas sent to each new user's wallet. Defaults to 1.0 on a local
# chain and 0.05 on any other network.
# WALLET_GAS_DRIP_ETH=

# Optional: blocks per event query while the backend catches up. Free RPC
# plans often cap this; lower it if catching up fails with a range error.
# INDEXER_BLOCK_RANGE=2000

# Optional: the most any transaction tips, in gwei. Defaults to 50 off a local
# chain. Amoy's node suggests 500+, which made deploying cost ~2.9 POL and every
# student action more than a new wallet holds; blocks accept 25. Raise this only
# if transactions sit unconfirmed.
# MAX_PRIORITY_FEE_GWEI=50

# ---------------------------------------------------------------------------
# Backend secrets
# ---------------------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs every session. WALLET_ENCRYPTION_KEY encrypts every user's
# wallet key — changing it later makes every existing wallet unreadable.
JWT_SECRET=
WALLET_ENCRYPTION_KEY=

# The platform owner's login at /admin, created on first start. Changing the
# password later signs out every admin session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
PORT=4000
# On a server behind nginx: HOST=127.0.0.1 (reachable only through nginx, never
# directly on port 4000) and TRUST_PROXY=1 (count each visitor's real address,
# not nginx's, for rate limits). Leave both unset locally.
# HOST=127.0.0.1
# TRUST_PROXY=1
# SQLite file, relative to backend/.
DB_PATH=data/chainproof.sqlite
# Where the website runs: used for password-reset links and to allow its
# requests (CORS).
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Email (Brevo — https://www.brevo.com, free tier)
# ---------------------------------------------------------------------------
# Without these, sign-up still works but no code is emailed, so students can't
# confirm their email — and can't be verified.
BREVO_API_KEY=
# Must be a sender address verified in Brevo.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ChainProof

# ---------------------------------------------------------------------------
# Optional tooling
# ---------------------------------------------------------------------------
# Verifying the contracts' source on amoy.polygonscan.com: one Etherscan key
# covers Polygon too — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Gas cost report when running the contract tests.
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# ---------------------------------------------------------------------------
# Testing only — leave unset for normal use
# ---------------------------------------------------------------------------
# DEPLOYMENT_MANIFEST=   point the backend at a throwaway deployment's manifest
# API_URL=               the backend the seed script and live suites talk to
# RPC_URL=               overrides NETWORK with an explicit RPC endpoint
